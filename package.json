{
  "name": "crow-companion",
  "version": "1.0.0",
  "type": "module",
  "description": "Crow Companion: Tallow, a little crow that lives on your desktop. A fork of Capri Desktop with every feature kept (chat, animations, tray, onboarding, voice) and a local Hugging Face model (digi-the-robot/Tallow) served by llama.cpp llama-server.",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/MycroftCanner2/CapriDesktop/tree/feat/crow-companion",
  "author": {
    "name": "nunezValen",
    "url": "https://github.com/nunezValen"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:portable": "electron-vite build && electron-builder --win portable --x64",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "llama:win": "bash scripts/crow/build-llama-server-win.sh"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.14",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "productName": "Crow Companion"
}
